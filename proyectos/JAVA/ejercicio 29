public class ej29 {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
       
       int opcion;
       do {
   
          System.out.println("=== Calculadora ===");
          System.out.println("1.Sumar  2.Restar  3.Multiplicar  4.Dividir  5.Salir");
          System.out.print("Seleccione una opcion: ") ;   
            opcion = sc.nextInt();
            
            switch (opcion) {
                case 1 -> {
                     int x, y;
                     System.out.println("Seleccione un numero 1");
                     x=sc.nextInt();
                     System.out.println("Seleccione un numero 2");
                     y=sc.nextInt();
                     int Resultado=x+y;
                    System.out.println("El resultado es "+Resultado);
                }
                
                case 2 -> {
                    System.out.println("Seleccione un numero 1");
                    int x=sc.nextInt();
                    System.out.println("Seleccione un numero 2");
                    int y=sc.nextInt();              
                    int resultado= x-y;
                    System.out.println("El resultado es "+resultado);
                }
                    
                case 3 -> {  
                    System.out.println("Seleccione un numero 1");
                    int x=sc.nextInt();
                    System.out.println("Seleccione un numero 2");
                    int y=sc.nextInt();              
                    int resultado= x*y;
                    System.out.println("El resultado es "+resultado);
                }
                    
                case 4 -> {
                    System.out.println("Seleccione un numero 1");
                    int x=sc.nextInt();
                    System.out.println("Seleccione un numero 2");
                    int y=sc.nextInt();  
                    int resultado= x/y;
                    System.out.println("El resultado es "+resultado);
                    }
                   
   
                     case 5 -> {
                    System.out.println("Hasta luego");
                     }
                default -> 
                    System.out.println("Opcion no valida. Intente de nuevo");
            }
            
        } while (opcion != 5);
        
    }
}

    
    

