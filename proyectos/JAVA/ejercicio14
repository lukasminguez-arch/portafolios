public class ejercicio14 {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        Character letra='a';
      ArrayList<Character> cadena= new ArrayList();
        for(int i=97; i<123;i++){
            Character caracter = (char) i;
        cadena.add(caracter);
    }     
        ArrayList<Character> vocales= new ArrayList(List.of('a','e','o','i','u'));
           for(char x:vocales){
              int posicion=0;
               for(char y: cadena){
                   if(x==y){
                       cadena.set(posicion,'@');
                       break;
                   }
                   posicion++;
               }
           }
        System.out.println(cadena);
    }
    
}